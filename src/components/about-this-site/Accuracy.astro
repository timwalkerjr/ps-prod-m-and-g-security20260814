<section class="bg-dark-background py-24 md:py-32 relative overflow-hidden">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(at 75% 50%, oklch(0.75 0.16 85 / 0.1), rgba(0, 0, 0, 0) 60%);"
  ></div>
  <div class="max-w-4xl mx-auto px-6 relative">
    <div class="mb-6">
      <span class="w-6 h-0.5 bg-primary mb-4 block"></span>
      <span class="text-primary text-[10px] uppercase font-bold tracking-widest">Accuracy & Updates</span>
    </div>
    <h2 class="text-[36px] leading-[44px] font-bold uppercase tracking-tight text-dark-foreground mb-8">
      Built for <span class="text-primary">Transparency</span>
    </h2>
    <p class="text-[16px] leading-[24px] text-dark-muted-foreground mb-6 max-w-3xl">
      This website was built with the best available information at the time of reconstruction. If any detail — contact info, service descriptions, personnel, or history — has changed or is inaccurate, please reach out and we will update it immediately.
    </p>
    <p class="text-[16px] leading-[24px] text-dark-muted-foreground/80 mb-12 max-w-3xl">
      We believe transparency builds trust, and this page exists to hold ourselves accountable to that standard.
    </p>
    <div class="flex flex-col sm:flex-row gap-4">
      <a
        href="https://mandgsecurity.clientsite.agency/contact-us"
        class="bg-primary text-foreground font-bold uppercase tracking-wider text-[12px] px-8 py-4 rounded-none hover:bg-primary-hover flex items-center justify-center gap-2"
      >
        <i class="ri-mail-line"></i>
        Contact Us
      </a>
      <a
        href="tel:+14848248631"
        class="border border-dark-foreground/30 text-dark-foreground font-bold uppercase tracking-wider text-[12px] px-8 py-4 rounded-none hover:bg-white/5 flex items-center justify-center gap-2"
      >
        <i class="ri-phone-line"></i>
        (484) 824-8631
      </a>
    </div>
  </div>
</section>
