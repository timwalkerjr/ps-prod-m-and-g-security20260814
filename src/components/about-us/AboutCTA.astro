<section class="bg-dark-background py-20 relative overflow-hidden">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(at 75% 50%, oklch(0.75 0.16 85 / 0.1), rgba(0, 0, 0, 0) 60%);"
  ></div>
  <div class="max-w-7xl mx-auto px-6 relative flex flex-col lg:flex-row justify-between items-start lg:items-center gap-8">
    <div class="max-w-3xl">
      <h2 class="text-[36px] leading-[44px] font-bold uppercase tracking-tight text-dark-foreground mb-4">
        Ready to Work With Us?
      </h2>
      <p class="text-[16px] leading-[24px] text-dark-muted-foreground">
        Contact M&amp;G Security today to discuss your security needs and receive a customized quote.
      </p>
    </div>
    <div class="flex flex-row gap-4">
      <a
        href="tel:+14848248631"
        class="bg-primary text-foreground font-bold uppercase tracking-wider text-[12px] px-8 py-4 rounded-none hover:bg-primary-hover flex items-center gap-2"
      >
        <i class="ri-phone-line"></i>
        (484) 824-8631
      </a>
      <a
        href="https://mandgsecurity.clientsite.agency/contact-us"
