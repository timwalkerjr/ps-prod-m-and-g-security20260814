<section class="bg-surface py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-16 md:gap-20 items-center">
    <div class="w-full">
      <img
        src="https://pagesmith-cdn.com/f57c14f2/images/188403e1fbb69132970a482c1828cd94-768.webp"
        alt="M&G Security team"
        class="w-full h-[450px] lg:h-[660px] object-cover rounded-none"
        loading="lazy"
      />
    </div>

    <div>
      <div class="mb-6">
        <span class="w-6 h-0.5 bg-primary mb-4 block"></span>
        <span class="text-primary text-[10px] uppercase font-bold tracking-widest">Our Story</span>
      </div>
      <h2 class="text-[36px] leading-[44px] font-bold uppercase tracking-tight text-foreground mb-6">
        Founded by Police,<br />Trusted by the Community
      </h2>
      <p class="text-[16px] leading-[24px] text-muted-foreground mt-6">
        M&amp;G Security was founded in <strong class="text-foreground">1997</strong> by former <strong class="text-foreground">Reading Police Sergeant Mark N. Pellicciotti</strong> and retired <strong class="text-foreground">Pennsylvania State Trooper Anthony DiGuglielmo</strong>.
      </p>
      <p class="text-[16px] leading-[24px] text-muted-foreground mt-4">
        Our staff consists of active and retired law enforcement personnel with over <span class="text-primary font-bold">60 years of combined law enforcement experience</span>. We bring the discipline, training, and professionalism of police work to every security assignment.
      </p>
      <p class="text-[16px] leading-[24px] text-muted-foreground/80 mt-4">
        From the Santander Arena to local construction sites, high school proms to corporate offices, we have protected the people and properties of Berks County with integrity and professionalism for over 27 years.
      </p>

      <div class="grid grid-cols-3 gap-4 mt-12 pt-8 border-t border-border">
        <div>
          <p class="text-primary text-[24px] font-bold">1997</p>
          <p class="text-muted-foreground text-[10px] uppercase tracking-wider font-bold">Year Founded</p>
        </div>
        <div>
          <p class="text-primary text-[24px] font-bold">60+</p>
          <p class="text-muted-foreground text-[10px] uppercase tracking-wider font-bold">Years LEO Exp.</p>
        </div>
        <div>
          <p class="text-primary text-[24px] font-bold">27+</p>
          <p class="text-muted-foreground text-[10px] uppercase tracking-wider font-bold">Years in Berks</p>
        </div>
      </div>
    </div>
  </div>
</section>
