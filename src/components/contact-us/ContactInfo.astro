---
---

<section class="bg-surface py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <div class="mb-6 inline-flex flex-col items-center">
        <span class="w-6 h-0.5 bg-primary mb-4 mx-auto"></span>
        <span class="text-primary text-[10px] uppercase font-bold tracking-widest">Get In Touch</span>
      </div>
      <h2 class="text-[48px] leading-[48px] font-bold uppercase tracking-tight text-foreground mb-4">
        Contact Information
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-7xl mx-auto">
      <div class="bg-background border border-gray-100 p-8 rounded-none hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-12 h-12 bg-primary/10 flex items-center justify-center text-primary mb-6 text-xl">
          <i class="ri-phone-line"></i>
        </div>
        <h3 class="text-[12px] font-bold text-muted-foreground uppercase tracking-wider mb-3">Phone</h3>
        <a
          href="tel:+14848248631"
          class="text-[18px] font-bold text-foreground hover:text-primary transition-colors block leading-snug"
        >
          (484) 824-8631
        </a>
      </div>

      <div class="bg-background border border-gray-100 p-8 rounded-none hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-12 h-12 bg-primary/10 flex items-center justify-center text-primary mb-6 text-xl">
          <i class="ri-mail-line"></i>
        </div>
        <h3 class="text-[12px] font-bold text-muted-foreground uppercase tracking-wider mb-3">Email</h3>
        <a
          href="mailto:info@theiroldurl.com"
          class="text-[14px] text-foreground hover:text-primary transition-colors block leading-snug break-all"
        >
          info@theiroldurl.com
        </a>
        <p class="text-[11px] text-muted-foreground mt-2 italic">placeholder — update before publish</p>
      </div>

      <div class="bg-background border border-gray-100 p-8 rounded-none hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-12 h-12 bg-primary/10 flex items-center justify-center text-primary mb-6 text-xl">
          <i class="ri-map-pin-line"></i>
        </div>
        <h3 class="text-[12px] font-bold text-muted-foreground uppercase tracking-wider mb-3">Mailing Address</h3>
        <p class="text-[14px] text-foreground leading-relaxed">
          P.O. Box 6255<br />Wyomissing, PA 19610
        </p>
      </div>

      <div class="bg-background border border-gray-100 p-8 rounded-none hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-12 h-12 bg-primary/10 flex items-center justify-center text-primary mb-6 text-xl">
          <i class="ri-time-line"></i>
        </div>
        <h3 class="text-[12px] font-bold text-muted-foreground uppercase tracking-wider mb-3">Availability</h3>
        <p class="text-[14px] text-foreground leading-relaxed">
          24/7 Emergency Response
        </p>
      </div>
    </div>
  </div>
</section>
