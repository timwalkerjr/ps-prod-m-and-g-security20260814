---
---

<section class="bg-dark-background py-24 md:py-32 relative overflow-hidden">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(at 25% 50%, oklch(0.75 0.16 85 / 0.08), rgba(0, 0, 0, 0) 55%);"
  ></div>
  <div class="max-w-5xl mx-auto px-6 relative">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-1 flex flex-col gap-8">
        <div class="bg-dark-background/50 border border-dark-border p-8 rounded-none">
          <h3 class="text-primary text-[10px] uppercase font-bold tracking-widest mb-4">By Mail</h3>
          <p class="text-dark-foreground text-[14px] leading-relaxed">
            M&amp;G Security<br />P.O. Box 6255<br />Wyomissing, PA 19610
          </p>
        </div>
        <div class="bg-dark-background/50 border border-dark-border p-8 rounded-none">
          <h3 class="text-primary text-[10px] uppercase font-bold tracking-widest mb-4">By Phone</h3>
          <a
            href="tel:+14848248631"
            class="text-dark-foreground text-[18px] font-bold hover:text-primary transition-colors block"
          >
            (484) 824-8631
          </a>
          <p class="text-dark-muted-foreground text-[12px] mt-2">Ask for the hiring manager</p>
        </div>
      </div>

      <div class="lg:col-span-2">
        <div class="mb-8">
          <span class="w-6 h-0.5 bg-primary mb-4 block"></span>
          <span class="text-primary text-[10px] uppercase font-bold tracking-widest">Submit Online</span>
          <h2 class="text-[36px] leading-[44px] font-bold uppercase tracking-tight text-dark-foreground mt-4 mb-4">
            Submit Your Application
          </h2>
          <p class="text-[16px] leading-[24px] text-dark-muted-foreground">
            Send your completed application and supporting documents to us. We recommend including your resume and any law enforcement credentials.
          </p>
        </div>

        <form class="bg-dark-background/50 border border-dark-border p-8 rounded-none grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex flex-col gap-2">
            <label class="text-dark-muted-foreground text-[12px] uppercase font-bold tracking-wider">First Name *</label>
            <input
              type="text"
              name="firstName"
              required
              class="bg-dark-background border border-dark-border text-dark-foreground px-4 py-3 rounded-none focus:outline-none focus:border-primary"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-dark-muted-foreground text-[12px] uppercase font-bold tracking-wider">Last Name *</label>
            <input
              type="text"
              name="lastName"
              required
              class="bg-dark-background border border-dark-border text-dark-foreground px-4 py-3 rounded-none focus:outline-none focus:border-primary"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-dark-muted-foreground text-[12px] uppercase font-bold tracking-wider">Email *</label>
            <input
              type="email"
              name="email"
              required
              class="bg-dark-background border border-dark-border text-dark-foreground px-4 py-3 rounded-none focus:outline-none focus:border-primary"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-dark-muted-foreground text-[12px] uppercase font-bold tracking-wider">Phone *</label>
            <input
              type="tel"
              name="phone"
              required
              class="bg-dark-background border border-dark-border text-dark-foreground px-4 py-3 rounded-none focus:outline-none focus:border-primary"
            />
          </div>
          <div class="flex flex-col gap-2 md:col-span-2">
            <label class="text-dark-muted-foreground text-[12px] uppercase font-bold tracking-wider">Law Enforcement Background</label>
            <select
              name="background"
              class="bg-dark-background border border-dark-border text-dark-foreground px-4 py-3 rounded-none focus:outline-none focus:border-primary"
            >
              <option>Select...</option>
              <option>Active Law Enforcement</option>
              <option>Retired Law Enforcement</option>
              <option>Security Experience</option>
              <option>Other/Military</option>
            </select>
          </div>
          <div class="flex flex-col gap-2 md:col-span-2">
            <label class="text-dark-muted-foreground text-[12px] uppercase font-bold tracking-wider">Message / Cover Letter</label>
            <textarea
              name="message"
              rows="5"
              class="bg-dark-background border border-dark-border text-dark-foreground px-4 py-3 rounded-none focus:outline-none focus:border-primary resize-none"
            ></textarea>
          </div>
          <div class="md:col-span-2">
            <button
              type="submit"
              class="bg-primary text-foreground font-bold uppercase tracking-wider text-[12px] px-8 py-4 rounded-none hover:bg-primary-hover flex items-center justify-center gap-2"
            >
              <i class="ri-send-plane-line"></i>
              Submit Application
            </button>
            <p class="text-dark-muted-foreground text-[12px] mt-4 italic">
              Note: We will contact you to arrange delivery of your completed application and supporting documents.
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
