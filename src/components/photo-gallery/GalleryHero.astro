---

<section class="bg-dark-background text-dark-muted-foreground py-[120px] md:py-[160px] relative overflow-hidden">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(at 100% 0%, oklch(0.75 0.16 85 / 0.12), rgba(0, 0, 0, 0) 55%);"
  ></div>
  <div class="max-w-4xl mx-auto px-6 flex flex-col items-center text-center relative">
    <div class="flex items-center gap-2 mb-6">
      <span class="w-1.5 h-4 bg-primary"></span>
      <span class="text-[12px] uppercase font-bold tracking-widest text-primary">Gallery</span>
    </div>
    <h1 class="text-[60px] leading-[60px] font-bold uppercase tracking-tight text-dark-foreground mb-8">
      M&amp;G Security <span class="text-primary">in Action</span>
    </h1>
    <p class="text-[16px] leading-[26px] max-w-[720px] text-dark-muted-foreground">
      Photos from events, construction sites, and venues across Berks County where M&amp;G Security has provided professional protection.
    </p>
  </div>
</section>

<section class="bg-dark-background border-t border-dark-border py-8">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4">
      <a
        href="#oktoberfest"
        class="text-dark-foreground hover:text-primary text-[12px] uppercase font-bold tracking-wider transition-colors border border-dark-border px-4 py-2 rounded-none"
      >
        Oktoberfest
      </a>
      <a
        href="#arena-sporting"
        class="text-dark-foreground hover:text-primary text-[12px] uppercase font-bold tracking-wider transition-colors border border-dark-border px-4 py-2 rounded-none"
      >
        Arena &amp; Sporting
      </a>
      <a
        href="#school-community"
        class="text-dark-foreground hover:text-primary text-[12px] uppercase font-bold tracking-wider transition-colors border border-dark-border px-4 py-2 rounded-none"
      >
        School &amp; Community
      </a>
      <a
        href="#our-team"
        class="text-dark-foreground hover:text-primary text-[12px] uppercase font-bold tracking-wider transition-colors border border-dark-border px-4 py-2 rounded-none"
      >
        Our Team
      </a>
      <a
        href="#operations-patrol"
        class="text-dark-foreground hover:text-primary text-[12px] uppercase font-bold tracking-wider transition-colors border border-dark-border px-4 py-2 rounded-none"
      >
        Operations &amp; Patrol
      </a>
      <a
        href="#festivals-events"
        class="text-dark-foreground hover:text-primary text-[12px] uppercase font-bold tracking-wider transition-colors border border-dark-border px-4 py-2 rounded-none"
      >
        Festivals &amp; Events
      </a>
    </div>
  </div>
</section>
