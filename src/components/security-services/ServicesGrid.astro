---
const services = [
  {
    title: 'Apartment Complex Security',
    icon: 'ri-building-line',
    body: 'Professional guards keep your community safe, handling resident concerns with courtesy and professionalism. Available 24/7 or on scheduled shifts.',
    href: '/security-services/apartment-complex',
  },
  {
    title: 'Public Auctions',
    icon: 'ri-auction-line',
    body: 'Crowd control and asset protection for public auctions of all sizes. Our guards manage traffic flow and secure merchandise and equipment.',
    href: '/security-services/auctions',
  },
  {
    title: 'Construction Sites',
    icon: 'ri-hammer-line',
    body: 'Secure your tools, equipment, and materials from theft. Our guards are present during and after hours to protect your valuable assets.',
    href: '/security-services/construction-sites',
  },
  {
    title: 'Festivals & Major Events',
    icon: 'ri-ticket-line',
    body: 'Large crowd management for festivals, concerts, and major public gatherings. We handle safety at public events with experienced personnel.',
    href: '/security-services/festivals-major-events',
  },
  {
    title: 'Sporting Events',
    icon: 'ri-trophy-line',
    body: 'Keep athletes and spectators safe at sporting events, conventions, and tournaments. Professional security at professional and amateur venues.',
    href: '/security-services/sporting-events',
  },
  {
    title: 'Concerts',
    icon: 'ri-mic-line',
    body: 'Venue security and crowd control for concerts and live performances. We manage safety for both indoor and outdoor concert venues.',
    href: '/security-services/concert-security',
  },
  {
    title: 'High School Events',
    icon: 'ri-graduation-cap-line',
    body: 'From sporting events to proms and graduations, we keep your school events safe. Our staff works seamlessly with school administrators.',
    href: '/security-services/high-school-events',
  },
  {
    title: 'Restaurant & Hospitality',
    icon: 'ri-restaurant-line',
    body: 'Overnight and maintenance-period security for restaurants and hospitality venues. We protect your establishment during vulnerable hours.',
    href: '/security-services/restaurant-maintenance',
  },
  {
    title: 'Private Investigations',
    icon: 'ri-search-eye-line',
    body: 'Our licensed private investigators provide discreet, professional investigative services for individuals and businesses throughout Pennsylvania.',
    href: '/security-services/private-investigation',
  },
];
---

<section id="services" class="bg-background py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        services.map((service) => (
          <a
            href={service.href}
            class="bg-surface border border-gray-100 p-8 rounded-none flex flex-col h-full justify-between hover:-translate-y-1 transition-all duration-300 group shadow-sm"
          >
            <div>
              <div class="w-12 h-12 bg-primary/10 flex items-center justify-center text-primary mb-6 text-xl">
                <i class={service.icon} aria-hidden="true" />
              </div>
              <h3 class="text-[18px] font-bold text-foreground mb-4 uppercase tracking-wide">
                {service.title}
              </h3>
              <p class="text-[14px] text-muted-foreground leading-relaxed mb-6">{service.body}</p>
            </div>
            <span class="text-primary text-[12px] font-bold tracking-wider uppercase group-hover:text-primary-hover flex items-center gap-1">
              Learn More <i class="ri-arrow-right-line" aria-hidden="true" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
