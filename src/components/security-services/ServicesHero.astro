---
---

<section
  id="services-hero"
  class="relative bg-dark-background overflow-hidden"
>
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(at 100% 0%, oklch(0.75 0.16 85 / 0.12), rgba(0, 0, 0, 0) 55%);"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-6 pt-[160px] pb-20 md:pt-[200px] md:pb-28 flex flex-col items-center text-center">
    <div class="flex items-center gap-2 mb-6">
      <span class="w-1.5 h-4 bg-primary block"></span>
      <span class="text-[12px] uppercase font-bold tracking-widest text-primary">Our Services</span>
    </div>

    <h1 class="text-[40px] leading-[44px] md:text-[60px] md:leading-[60px] font-bold uppercase tracking-tight text-dark-foreground max-w-[900px]">
      Professional Security <span class="text-primary">for Every Need</span>
    </h1>

    <p class="text-[16px] leading-[26px] text-dark-muted-foreground max-w-[720px] mx-auto mt-6">
      M&amp;G Security provides comprehensive security services for events, construction sites,
      corporate properties, and more. Our team of active and retired law enforcement officers
      brings unmatched professionalism to every assignment.
    </p>
  </div>
</section>
