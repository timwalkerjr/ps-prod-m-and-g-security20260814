---
---
<section id="colors" class="bg-surface py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center gap-2 mb-4">
      <span class="w-6 h-0.5 bg-primary"></span>
      <span class="text-primary text-[10px] uppercase font-bold tracking-widest">Color System</span>
    </div>
    <h2 class="text-foreground text-[48px] leading-[48px] font-bold uppercase tracking-[-0.96px] mb-4">Palette Tokens</h2>
    <p class="text-muted-foreground text-[16px] leading-[26px] max-w-2xl mb-16">Five color roles keep the palette flexible: Primary for brand energy, Secondary for depth, Accent for contrast moments, Background for the canvas, and Foreground for readable text.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      <div class="border border-border bg-background p-8">
        <span class="text-primary text-[10px] uppercase font-bold tracking-widest mb-4 block">primary</span>
        <h3 class="font-heading text-[18px] font-bold uppercase text-foreground mb-4">Primary</h3>
        <div class="w-full h-24 bg-primary mb-4"></div>
        <p class="text-[14px] text-muted-foreground">Gold — CTAs, accents, hover states, brand energy</p>
      </div>

      <div class="border border-border bg-background p-8">
        <span class="text-primary text-[10px] uppercase font-bold tracking-widest mb-4 block">accent</span>
        <h3 class="font-heading text-[18px] font-bold uppercase text-foreground mb-4">Accent</h3>
        <div class="w-full h-24 bg-secondary mb-4"></div>
        <p class="text-[14px] text-muted-foreground">Muted blue-grey — secondary highlights, subtle contrast</p>
      </div>

      <div class="border border-border bg-background p-8">
        <span class="text-primary text-[10px] uppercase font-bold tracking-widest mb-4 block">secondary</span>
        <h3 class="font-heading text-[18px] font-bold uppercase text-foreground mb-4">Secondary</h3>
        <div class="w-full h-24 bg-dark-background mb-4 border border-border"></div>
        <p class="text-[14px] text-muted-foreground">Dark charcoal — footer, dark sections, depth</p>
      </div>

      <div class="border border-border bg-background p-8">
        <span class="text-primary text-[10px] uppercase font-bold tracking-widest mb-4 block">background</span>
        <h3 class="font-heading text-[18px] font-bold uppercase text-foreground mb-4">Background</h3>
        <div class="w-full h-24 bg-background mb-4 border border-border"></div>
        <p class="text-[14px] text-muted-foreground">Near-white — page canvas, card fills, calm base</p>
      </div>

      <div class="border border-border bg-background p-8">
        <span class="text-primary text-[10px] uppercase font-bold tracking-widest mb-4 block">foreground</span>
        <h3 class="font-heading text-[18px] font-bold uppercase text-foreground mb-4">Foreground</h3>
        <div class="w-full h-24 bg-foreground mb-4"></div>
        <p class="text-[14px] text-muted-foreground">Text scale — body, muted, strong, headings</p>
      </div>
    </div>

    <h3 class="font-heading text-[24px] font-bold uppercase text-foreground mb-6 tracking-wide">Primary Scale</h3>
    <div class="grid grid-cols-5 md:grid-cols-10 gap-2">
      <div class="aspect-square bg-primary/5 flex items-end justify-center p-2 border border-border">
        <span class="text-[10px] font-bold text-foreground">50</span>
      </div>
      <div class="aspect-square bg-primary/10 flex items-end justify-center p-2 border border-border">
        <span class="text-[10px] font-bold text-foreground">100</span>
      </div>
      <div class="aspect-square bg-primary/20 flex items-end justify-center p-2 border border-border">
        <span class="text-[10px] font-bold text-foreground">200</span>
      </div>
      <div class="aspect-square bg-primary/30 flex items-end justify-center p-2 border border-border">
        <span class="text-[10px] font-bold text-foreground">300</span>
      </div>
      <div class="aspect-square bg-primary/40 flex items-end justify-center p-2 border border-border">
        <span class="text-[10px] font-bold text-foreground">400</span>
      </div>
      <div class="aspect-square bg-primary flex items-end justify-center p-2">
        <span class="text-[10px] font-bold text-foreground">500</span>
      </div>
      <div class="aspect-square bg-primary/60 flex items-end justify-center p-2">
        <span class="text-[10px] font-bold text-foreground">600</span>
      </div>
      <div class="aspect-square bg-primary/70 flex items-end justify-center p-2">
        <span class="text-[10px] font-bold text-foreground">700</span>
      </div>
      <div class="aspect-square bg-primary/80 flex items-end justify-center p-2">
        <span class="text-[10px] font-bold text-foreground">800</span>
      </div>
      <div class="aspect-square bg-primary/90 flex items-end justify-center p-2">
        <span class="text-[10px] font-bold text-foreground">900</span>
      </div>
    </div>
  </div>
</section>