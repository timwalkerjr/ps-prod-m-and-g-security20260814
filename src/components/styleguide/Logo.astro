---
const lockupDark = "https://pagesmith-cdn.com/f57c14f2/images/3d957a88-20e5-4612-a102-248b0fcabfa4_compressed_mg-lockup_gold-head_white-text-1536.webp";
const lockupLight = "https://pagesmith-cdn.com/f57c14f2/images/42c0ed8a-149c-47e3-826b-40c75869f0af_mg-lockup_gold-head_black-text.svg";

const lockups = [
  { src: "https://pagesmith-cdn.com/f57c14f2/images/3d957a88-20e5-4612-a102-248b0fcabfa4_compressed_mg-lockup_gold-head_white-text-1536.webp", label: "Gold head, white text", bg: "dark" },
  { src: "https://pagesmith-cdn.com/f57c14f2/images/42c0ed8a-149c-47e3-826b-40c75869f0af_mg-lockup_gold-head_black-text.svg", label: "Gold head, black text", bg: "light" },
  { src: "https://pagesmith-cdn.com/f57c14f2/images/cc2b1d7c-186f-4afa-b4b9-c0e583cee22a_compressed_mg-lockup_gold-head_blue-text-1536.webp", label: "Gold head, blue text", bg: "light" },
  { src: "https://pagesmith-cdn.com/f57c14f2/images/d7f49764-8698-4f01-91af-571f54f262b2_compressed_mg-lockup_blue-head_white-text-1536.webp", label: "Blue head, white text", bg: "dark" },
  { src: "https://pagesmith-cdn.com/f57c14f2/images/f6443a6a-1ceb-4095-9c0f-8a43bee84653_mg-lockup_blue-head_black-text.svg", label: "Blue head, black text", bg: "light" },
  { src: "https://pagesmith-cdn.com/f57c14f2/images/47b57796-9cfc-4dff-81cc-9709469dc2ff_mg-lockup_blue-head_blue-text.svg", label: "Blue head, blue text", bg: "light" },
  { src: "https://pagesmith-cdn.com/f57c14f2/images/c9b3c5be-ac70-46c6-9849-bc743971f578_compressed_mg-lockup_white-head_white-text-1536.webp", label: "White head, white text", bg: "dark" },
  { src: "https://pagesmith-cdn.com/f57c14f2/images/f59b94a9-23ca-4052-ba0e-0f2d727bf775_compressed_mg-lockup_white-head_blue-text-1536.webp", label: "White head, blue text", bg: "light" },
];

const goldIcons = [
  { src: "https://pagesmith-cdn.com/f57c14f2/images/9dde094c-c664-4463-81b5-444ebed6ceef_compressed_mg-icon_gold-48-48.webp", size: "48px" },
  { src: "https://pagesmith-cdn.com/f57c14f2/images/e8127dbb-b200-4057-b1cc-79acec67ca22_compressed_mg-icon_gold-192-192.webp", size: "192px" },
  { src: "https://pagesmith-cdn.com/f57c14f2/images/2eb0ca24-78a4-40f2-9fb5-54c9476a760e_compressed_mg-icon_gold-512-320.webp", size: "512px" },
];

const whiteIcons = [
  { src: "https://pagesmith-cdn.com/f57c14f2/images/9424f734-6019-4731-a010-1b002c06f410_compressed_mg-icon_white-180-180.webp", size: "180px" },
  { src: "https://pagesmith-cdn.com/f57c14f2/images/a896a30b-ca8d-4065-aeda-fafcce013820_compressed_mg-icon_white-192-192.webp", size: "192px" },
  { src: "https://pagesmith-cdn.com/f57c14f2/images/c49529b8-ecf9-498c-acf1-5651fc9dc6e0_compressed_mg-icon_white-512-320.webp", size: "512px" },
];

const blueIcons = [
  { src: "https://pagesmith-cdn.com/f57c14f2/images/2a053674-5c4a-45e3-9179-c2d56ae8a4a6_compressed_mg-icon_blue-180-180.webp", size: "180px" },
  { src: "https://pagesmith-cdn.com/f57c14f2/images/48c83017-1830-4d5d-832e-9f7132c92095_compressed_mg-icon_blue-192-192.webp", size: "192px" },
  { src: "https://pagesmith-cdn.com/f57c14f2/images/0351286a-290e-47fa-8ae8-626293341993_compressed_mg-icon_blue-512-320.webp", size: "512px" },
];
---
<section id="logo" class="bg-background py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center gap-2 mb-4">
      <span class="w-6 h-0.5 bg-primary"></span>
      <span class="text-primary text-[10px] uppercase font-bold tracking-widest">Logo</span>
    </div>
    <h2 class="text-foreground text-[48px] leading-[48px] font-bold uppercase tracking-[-0.96px] mb-4">Brand Mark</h2>
    <p class="text-muted-foreground text-[16px] leading-[26px] max-w-2xl mb-16">The M&amp;G Security lockup features the bulldog mark alongside bold text. Multiple head and text color combinations are available for use across light, dark, and tinted backgrounds.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      <div class="bg-dark-background border border-dark-border p-12 flex items-center justify-center min-h-[240px]">
        <img src={lockupDark} alt="M&G Security logo on dark background" class="max-h-32 w-auto object-contain" />
      </div>
      <div class="bg-surface border border-border p-12 flex items-center justify-center min-h-[240px]">
        <img src={lockupLight} alt="M&G Security logo on light background" class="max-h-32 w-auto object-contain" />
      </div>
    </div>

    <p class="text-muted-foreground text-[15px] leading-[24px] mb-12 max-w-3xl">Primary use: dark background with white text and gold bulldog. Light-background usage should use the black-text variant for legibility.</p>

    <h3 class="font-heading text-[24px] font-bold uppercase text-foreground mb-6 tracking-wide">Full Lockup Set</h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-20">
      {lockups.map((lockup) => (
        <div class={`${lockup.bg === 'dark' ? 'bg-dark-background border-dark-border' : 'bg-surface border-border'} border p-6 flex flex-col items-center justify-center min-h-[160px] gap-3`}>
          <img src={lockup.src} alt={lockup.label} class="max-h-12 w-auto object-contain" />
          <span class={`text-[10px] uppercase font-bold tracking-wider ${lockup.bg === 'dark' ? 'text-dark-muted-foreground' : 'text-muted-foreground'}`}>{lockup.label}</span>
        </div>
      ))}
    </div>

    <p class="text-muted-foreground text-[15px] leading-[24px] mb-12 max-w-3xl">All lockup variants are approved for use. Choose the combination that provides the strongest contrast against the target background.</p>

    <h3 class="font-heading text-[24px] font-bold uppercase text-foreground mb-4 tracking-wide">Icon Mark</h3>
    <p class="text-muted-foreground text-[15px] leading-[24px] mb-12 max-w-3xl">The standalone bulldog icon — used where space is tight: favicons, social avatars, app icons, and small UI elements. Never use the icon smaller than 16px to preserve detail.</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-surface border border-border p-8">
        <h4 class="font-heading text-[12px] font-bold uppercase text-primary tracking-widest mb-6">Gold</h4>
        <div class="flex items-end gap-4 mb-4">
          {goldIcons.map((icon) => (
            <div class="flex flex-col items-center gap-2">
              <img src={icon.src} alt={`Gold icon ${icon.size}`} class="object-contain" style={`width: ${Math.min(parseInt(icon.size), 96)}px; height: ${Math.min(parseInt(icon.size), 96)}px;`} />
            </div>
          ))}
        </div>
        <p class="text-[11px] text-muted-foreground uppercase tracking-wider">48px · 192px · 512px</p>
      </div>

      <div class="bg-dark-background border border-dark-border p-8">
        <h4 class="font-heading text-[12px] font-bold uppercase text-primary tracking-widest mb-6">White</h4>
        <div class="flex items-end gap-4 mb-4">
          {whiteIcons.map((icon) => (
            <div class="flex flex-col items-center gap-2">
              <img src={icon.src} alt={`White icon ${icon.size}`} class="object-contain" style={`width: ${Math.min(parseInt(icon.size), 96)}px; height: ${Math.min(parseInt(icon.size), 96)}px;`} />
            </div>
          ))}
        </div>
        <p class="text-[11px] text-dark-muted-foreground uppercase tracking-wider">180px · 192px · 512px</p>
      </div>

      <div class="bg-surface border border-border p-8">
        <h4 class="font-heading text-[12px] font-bold uppercase text-primary tracking-widest mb-6">Blue</h4>
        <div class="flex items-end gap-4 mb-4">
          {blueIcons.map((icon) => (
            <div class="flex flex-col items-center gap-2">
              <img src={icon.src} alt={`Blue icon ${icon.size}`} class="object-contain" style={`width: ${Math.min(parseInt(icon.size), 96)}px; height: ${Math.min(parseInt(icon.size), 96)}px;`} />
            </div>
          ))}
        </div>
        <p class="text-[11px] text-muted-foreground uppercase tracking-wider">180px · 192px · 512px</p>
      </div>
    </div>
  </div>
</section>