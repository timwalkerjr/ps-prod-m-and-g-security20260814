---
---
<section id="typography" class="bg-background py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center gap-2 mb-4">
      <span class="w-6 h-0.5 bg-primary"></span>
      <span class="text-primary text-[10px] uppercase font-bold tracking-widest">Typography</span>
    </div>
    <h2 class="text-foreground text-[48px] leading-[48px] font-bold uppercase tracking-[-0.96px] mb-4">Fonts &amp; Hierarchy</h2>
    <p class="text-muted-foreground text-[16px] leading-[26px] max-w-2xl mb-16">Two font families work together: Space Grotesk for headlines and labels (strong, geometric, confident), Manrope for body copy (clean, modern, readable).</p>

    <div class="space-y-12">
      <div class="border border-border p-8 bg-surface">
        <span class="text-primary text-[10px] uppercase font-bold tracking-widest mb-4 block">Display / H1</span>
        <p class="font-heading text-[60px] leading-[60px] font-bold text-foreground tracking-[-1.2px]">Professional Security</p>
      </div>

      <div class="border border-border p-8 bg-surface">
        <span class="text-primary text-[10px] uppercase font-bold tracking-widest mb-4 block">H2</span>
        <p class="font-heading text-[48px] leading-[48px] font-bold text-foreground tracking-[-0.96px]">Section Headline</p>
      </div>

      <div class="border border-border p-8 bg-surface">
        <span class="text-primary text-[10px] uppercase font-bold tracking-widest mb-4 block">H3</span>
        <p class="font-heading text-[18px] leading-[24px] font-bold uppercase text-foreground tracking-wide">Card / Component Title</p>
      </div>

      <div class="border border-border p-8 bg-surface">
        <span class="text-primary text-[10px] uppercase font-bold tracking-widest mb-4 block">Body</span>
        <p class="text-[16px] leading-[26px] text-muted-foreground max-w-2xl">Manrope is used for body copy. It reads clean at any size with generous letter-spacing and comfortable line height.</p>
      </div>

      <div class="border border-border p-8 bg-surface">
        <span class="text-primary text-[10px] uppercase font-bold tracking-widest mb-4 block">Label / Button</span>
        <p class="font-heading text-[12px] font-bold uppercase tracking-wider text-primary">UPPERCASE TRACKING</p>
      </div>
    </div>
  </div>
</section>