---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SportHero from '@/components/security-services/SportHero.astro';
import ServiceContent from '@/components/security-services/ServiceContent.astro';
import ServiceCTA from '@/components/security-services/ServiceCTA.astro';

const paragraphs = [
  "In most every instance when a large public gathering takes place, like a concert with thousands of guests, there are security issues. M&amp;G Security provides professional venue security that keeps performers, staff, and audiences safe so the show goes on without interruption.",
  "Concert security demands a unique combination of vigilance and customer service. Our guards are trained to spot intoxicated or disruptive individuals, enforce venue policies, and handle medical emergencies while maintaining a professional demeanor that respects concertgoers' experience.",
  "We have provided security for concerts and live performances at venues throughout southeastern Pennsylvania, including the Santander Arena in Reading. Whether it's a local band at a small venue or a major touring act at a large arena, M&amp;G Security brings the same level of professionalism and preparedness to every show.",
];

const bullets = [
  "Entry point screening and ticket verification",
  "Stage and performer area protection",
  "Crowd barrier and pit monitoring",
  "Alcohol and substance enforcement",
  "Emergency evacuation coordination",
  "VIP, backstage, and green room security",
  "Parking lot and tailgate oversight",
  "Lost and found assistance",
];
---

<BaseLayout
  title="Concert Security | M&G Security Berks County"
  description="Professional concert and venue security across Berks County, PA. M&G Security provides crowd control, stage protection, and emergency coordination for live performances."
>
  <SportHero
    title="Concert security"
    subtitle="We'll keep your concert safe"
    breadcrumb="Concert security"
  />
  <ServiceContent
    title="Concert security"
    paragraphs={paragraphs}
    bullets={bullets}
    serviceShortName="concert"
  />
  <ServiceCTA title="Concert security" />
</BaseLayout>
